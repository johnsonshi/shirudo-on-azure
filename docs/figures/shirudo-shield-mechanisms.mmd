%% Editable Mermaid source for docs/figures/shirudo-shield-mechanisms.svg
flowchart TB
    subgraph LIFE["1. Temporary Shield Lifecycle (Buys Time, Never Replaces Patching)"]
        direction LR
        L1["Advisory Disclosed<br/>Patch under test"] --> L2["Operator Signs Shield<br/>ML-DSA-87 .upatch"]
        L2 --> L3["Target Loads Shield<br/>Measured in vTPM register"]
        L3 --> L4["Permanent Patch Rolls Out<br/>Kernel, JVM, or PHP upgraded"]
        L4 --> L5["Payload-Matched Signed Unload<br/>Verifies payload_sha256 + detaches"]
    end

    subgraph COMP["2. Enforcement Boundary by Shield Type in Shipped Shirudo"]
        direction LR

        subgraph S_BPF["Kernel BPF Upatch"]
            direction TB
            B1["Verify: .bpf keyring checks<br/>ML-DSA-87 signed loader"]
            B2["Activate: Live BPF LSM, tracing, or XDP<br/>attach (labeled sandbox on next exec)"]
            B3["Verified: basic + AF_ALG (allowed -> EPERM<br/>at lab af_alg_restrict=0; later restored to 1)"]
            B1 --> B2 --> B3
        end

        subgraph S_JAVA["Java Upatch (type = java)"]
            direction TB
            J1["Verify: Userspace check; seals<br/>Premain-Class JAR in /run/shirudo-java"]
            J2["Activate: Sets JAVA_TOOL_OPTIONS<br/>for new JVMs via environment.d"]
            J3["Verified: Base64 continuity + JDBC guard<br/>(SQLite fixture + real H2 in-memory DB)"]
            J1 --> J2 --> J3
        end

        subgraph S_PHP["PHP Containment (app-sandbox)"]
            direction TB
            P1["Mechanism: BPF LSM labels<br/>httpd + php-fpm workers"]
            P2["Verified: .php EACCES vs .txt allow<br/>(Python fixture + real PHP-FPM Unix socket)"]
            P3["Limit: Does not fix PHP itself;<br/>still upgrade PHP"]
            P1 --> P2 --> P3
        end
    end

    LIFE --> COMP

    classDef stepBox fill:#eff6ff,stroke:#2563eb,stroke-width:1.5px,color:#0f172a
    classDef bpfBox fill:#ecfdf5,stroke:#059669,stroke-width:1.5px,color:#0f172a
    classDef javaBox fill:#fffbeb,stroke:#d97706,stroke-width:1.5px,color:#0f172a
    classDef phpBox fill:#fef2f2,stroke:#dc2626,stroke-width:1.5px,color:#0f172a

    class L1,L2,L3,L4,L5 stepBox
    class B1,B2,B3 bpfBox
    class J1,J2,J3 javaBox
    class P1,P2,P3 phpBox
