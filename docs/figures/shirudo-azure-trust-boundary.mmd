%% Editable Mermaid source for docs/figures/shirudo-azure-trust-boundary.svg
%% Experimental Azure IaaS port (not official Azure support; managed AKS not tested).
flowchart LR
    subgraph OP["Operator VM (Standard_D32ds_v5, vTPM ON, Secure Boot ON)"]
        direction TB
        OP_KEYS["Role 1: Operator Signing Keypairs<br/>Separate bpf + config ML-DSA-87 keys<br/>(Never leave operator)"]
        OP_BUILD["Azure Compatibility Build<br/>bpf-next + Hyper-V built-ins<br/>TPM_NV_RSA_BITS = 2048"]
        OP_ART["Signed Artifacts + Packages<br/>dm-verity runtime + config images<br/>Signed .upatch load/unload + OCI bpm"]
        OP_VER["Offline Verifier (attest verify)<br/>Fresh nonce + Quote + NV_Certify<br/>Replays eventlog + RSA-2048 NV Name"]
        OP_KEYS --> OP_BUILD --> OP_ART
    end

    subgraph TGT["Target VM (Standard_D4ds_v5, Base 26.04.202611100, No Inbound App Ports)"]
        direction TB

        subgraph BOOT["Boot + Initrd (Caveat: Secure Boot OFF, Unsigned UKI)"]
            direction TB
            UKI["Unsigned UKI via GRUB<br/>PCRs 9/11 record boot,<br/>do not authenticate boot"]
            INIT["Initrd (dracut + shirudo init)<br/>Early TPM setup + EBUSY retry<br/>Binds NV register + seals keyrings"]
            UKI --> INIT
        end

        subgraph KRN["Enforced Kernel in This Boot (Patched bpf-next)"]
            direction TB
            KR["Sealed Keyrings<br/>.bpf + .dm-verity keyrings"]
            LSM["Pinned lsm/bpf Guard<br/>Denies unsigned BPF load, map edit,<br/>and link detach in this boot"]
            BPF_SH["Kernel BPF Shields + app-sandbox<br/>Live LSM/XDP hooks;<br/>contains child exec/net/writes"]
            KR --> LSM --> BPF_SH
        end

        subgraph USR["Target Userspace (One-Shot CLI)"]
            direction TB
            STATUS["7 Status Conditions OK<br/>Runtime binary in /run/shirudo/runtime"]
            JAVA_SH["Java Upatch (type = java)<br/>Userspace check, /run/shirudo-java JAR,<br/>JAVA_TOOL_OPTIONS at JVM startup"]
        end

        subgraph VTPM["Microsoft Hyper-V vTPM (/dev/tpmrm0)"]
            direction TB
            NVW["Role 3: Per-Boot NV Writer<br/>RSA-2048 owner primary<br/>(Stock RSA-3072 -> TPM_RC_VALUE)"]
            REG["Measurement Register 0x01818E00<br/>Policy-gated TPM2_NV_Extend"]
            AK["Role 2: Attestation Key (AK)<br/>ECDSA P-256 signs Quote + NV_Certify<br/>(Proves state, not VM identity)"]
            NVW --> REG --> AK
        end

        INIT --> KR
        INIT --> NVW
        LSM -. "extends" .-> NVW
        LSM -. "seals JAR" .-> JAVA_SH
        STATUS --- LSM
    end

    OUT_SCOPE["Out of Tested Scope: Managed AKS<br/>AKS Linux pools support vTPM, but disallow IaaS OS replacement;<br/>4 workloads, latency, and IG unmeasured pending receipts"]

    OP_ART ==>|"Bootstrap bundle<br/>(public certs + images)"| INIT
    OP_ART ==>|"2 transports: SSH/file staging<br/>or OCI registry pull (bpm)"| LSM
    AK ==>|"Evidence JSON + fresh nonce"| OP_VER

    classDef operatorBox fill:#eff6ff,stroke:#1d4ed8,stroke-width:2px,color:#0f172a
    classDef kernelBox fill:#ecfdf5,stroke:#047857,stroke-width:2px,color:#0f172a
    classDef caveatBox fill:#fffbeb,stroke:#b45309,stroke-width:2px,color:#0f172a
    classDef vtpmBox fill:#f5f3ff,stroke:#6d28d9,stroke-width:2px,color:#0f172a
    classDef scopeBox fill:#f1f5f9,stroke:#64748b,stroke-dasharray: 5 5,color:#334155

    class OP_KEYS,OP_BUILD,OP_ART,OP_VER operatorBox
    class KR,LSM,BPF_SH kernelBox
    class UKI,INIT,JAVA_SH caveatBox
    class NVW,REG,AK vtpmBox
    class OUT_SCOPE scopeBox
