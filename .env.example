# Copy to .env and fill in. .env is gitignored and never committed.
# Every script under infra/ and demos/ reads these values.

# Azure placement
AZ_SUBSCRIPTION=<subscription-name-or-id>
AZ_LOCATION=westus3
AZ_RESOURCE_GROUP=<resource-group>

# Two VMs: the operator builds and signs; the target enforces.
OPERATOR_VM=shirudo-operator
OPERATOR_SIZE=Standard_D32ds_v5
TARGET_VM=shirudo-target
TARGET_SIZE=Standard_D4ds_v5
UBUNTU_IMAGE=Canonical:ubuntu-26_04-lts:server:latest

# SSH
ADMIN_USER=azureuser
SSH_KEY=~/.ssh/shirudo_on_azure_ed25519
# Only this CIDR may reach port 22 (your workstation's public IP/32).
ALLOWED_SSH_CIDR=<your-public-ip>/32
# Optional: several sources, space separated, CIDRs or NSG service tags.
# Behind a corporate secure web gateway (Global Secure Access, Zscaler...)
# SSH leaves from rotating egress IPs; "AzureCloud" covers Azure-hosted ones.
# ALLOWED_SSH_SOURCES="<your-public-ip>/32 AzureCloud"

# Extra strings the leak check must never find in tracked files or history
# (aliases, tenant names, hostnames). Comma separated.
PRIVATE_TERMS=
